# Visual Test Range - framed specimens for confirming what the renderer actually draws.
#
# LM Test Range asserts BEHAVIOR headlessly. This range is the opposite case: the things
# only an eye can settle. Each specimen is one subject, framed identically every run, with
# a card on screen saying what a correct frame shows - so a wrong result is visible without
# reading any code, and anyone can judge it, not just whoever wrote it.
#
# Standalone on purpose: sbslib only, no LM mastlibs, so there is no rebuild step between
# an edit and a look. The mission ships its own server picker and client console.
#
#     python -m cosmos_dev.mission_runner VisualTestRange --gui
#         then open http://localhost:8765/server   (picker + view + card)
#     python -m cosmos_dev.mission_runner VisualTestRange --gui --map visual_blackhole
#     python -m cosmos_dev.mission_runner VisualTestRange --map visual_art_census --test 20
#
# The last form is headless: no picture, but the VISUAL PASS/FAIL checks still run, so the
# data half of every specimen is CI-able even though the picture is not.

import maps/visual_harness.py
import maps/visual_console.mast
import maps/visual_all.mast

# --- specimens -------------------------------------------------------------
import maps/visual_art_census.mast
import maps/visual_blackhole.mast
import maps/visual_planet.mast
import maps/visual_torpedo.mast
import maps/visual_beam_arcs.mast
import maps/visual_fx_client_scope.mast
import maps/visual_terrain_field.mast
import maps/visual_scale_ladder.mast
import maps/visual_nebula.mast
import maps/visual_motion.mast
import maps/visual_shield_rings.mast
import maps/visual_button_chrome.mast
import maps/visual_lower_third_portrait.mast
import maps/visual_square_panel.py
import maps/visual_square_width.mast
import maps/visual_cutscene.mast

# --- Phase 0 camera spikes (CINEMATIC_PLAN.md) -----------------------------
import maps/visual_camera_offsets.mast
import maps/visual_camera_cut.mast
import maps/visual_camera_rate.mast
import maps/visual_camera_zero_id.mast


# A tool mission: no connect dialog.
sbs.suppress_client_connect_dialog(0)

# How long visual_all holds each specimen on screen before building the next.
shared VISUAL_HOLD_SECONDS = 6


# The LM consoles addon owns the way in, exactly as it does for LM Test Range: its
# server_console draws the mission picker from the @map roster, applies the map's Defaults,
# task_schedules the chosen map, sets GAME_STARTED and handles --map / AUTO_START. So a
# specimen needs no launch code of its own and a new @map/visual_* appears in the picker for
# free. The two routes below are all the range adds on top.

//shared/signal/create_sides
    # start_server emits this before player ships and before any map runs, so side keys
    # resolve. Two sides is all any specimen needs (a friendly and something to shoot at),
    # and they are the baseline visual_reset_objects() deliberately keeps. side_ensure is
    # idempotent, so this stays safe to re-run - which it must be, since a mid-mission
    # sim_create leaves the sim handle stale for the rest of the frame.
    side_ensure("tsn", "TSN")
    side_ensure("raider", "Raider")
    side_set_relations("tsn", "raider", sbs.DIPLOMACY.HOSTILE)


//shared/signal/game_started
    # Hand the screens to the range once a specimen has been launched.
    task_schedule(visual_present)


=== visual_present
    # A tick late on purpose: start_server does its OWN gui_reroute_clients(game_started_console)
    # immediately AFTER emitting game_started, so rerouting inline would just be overwritten.
    await delay_sim(1)
    # Both get the SAME stage. Every camera console that works in LM - Game Master, Manual
    # Beams - runs on a CLIENT, and this range only ever ran its camera on client 0, which is
    # an uncontrolled variable sitting under every camera problem here. One screen for both
    # also removes a server/client divergence, which is its own source of "works there, not
    # here".
    gui_reroute_server("visual_stage")
    gui_reroute_clients("visual_stage")
    ->END
