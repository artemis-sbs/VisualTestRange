# SPIKE: what makes a camera change actually TAKE, and what a deleted dolly does.
#
# Engine-observed so far: a change only took when the console was ASSIGNED to the object the
# lens rides, and the assignment has to come FIRST - assign, then point. Re-pointing alone was
# a black screen. These four beats separate the variables so that is confirmed rather than
# inferred from one lucky run:
#
#   1  POINT ONLY          re-point to camB, client left where it was.       (the control)
#   2  ASSIGN THEN POINT   identical, except the client is assigned to camA first.
#   3  MOVE                no id change, no reassignment: the cambot the lens is already
#                          riding is teleported.
#   4  DELETE              the live dolly is destroyed under a live pin.
#
# Beats 1 and 2 differ by EXACTLY one thing, so whichever draws answers whether assignment is
# required. Beat 3 asks whether moving differs from re-pointing. Beat 4 decides whether
# releasing the camera before cleanup has to be a rule in the API.
#
# The card names each beat as it fires, so a black frame is always attributable.

@map/visual_camera_cut "Visual: camera cut (spike)"
" Four beats: point only, assign-then-point, move, delete. Which of them draws?
    visual_set_index_by_name("camera_cut")
    await task_schedule(run_visual_camera_cut)
    ->END


=== run_visual_camera_cut
metadata: ``` yaml
type: visual/camera_cut
```
    # One subject, plus fixed rocks: without a stationary reference a slide and a snap are
    # hard to tell apart at speed.
    _subject = to_object(npc_spawn(0, 0, 0, "Subject", "tsn", "starbase_command", "behav_station"))
    ->END if _subject is None
    for _ci in range(7):
        terrain_spawn(0 - 4500 + _ci * 1500, 0, 3000, f"ref{_ci}", "#,ref", "plain_asteroid_8", "behav_asteroid")

    # Two viewpoints. Both anchors sit ON THE PLANE with their height carried in the eye
    # offset, matching every specimen that renders correctly in the engine - the two that did
    # not were the only ones putting height into the anchor and pinning with a zero offset.
    shared VISUAL_CUT_A = visual_anchor(0, 0, 0 - 2200, "camA")
    shared VISUAL_CUT_B = visual_anchor(2600, 0, 1800, "camB")
    shared VISUAL_CUT_SUBJECT = _subject.id

    visual_camera(VISUAL_CUT_A, lens=(0, 400, 0), target_id=_subject.id)
    task_schedule(visual_camera_cut_driver)

    _expect = ~~[
        "beat 1 POINT ONLY: lens asked to move to camB, client left where it was",
        "beat 2 ASSIGN THEN POINT: assigned to camA first, then the lens moved to it",
        "1 and 2 differ by exactly one thing - whichever draws answers whether assign is needed",
        "beat 3 MOVE: no id change, no reassign - the cambot the lens rides is teleported",
        "beat 4 the live dolly is DELETED - does the view hold, or fall away?",
    ]~~
    visual_case("Camera cut", _expect, subtitle="does a change need the assignment, and in which order", notes="beat 1 of 4: POINT ONLY (no reassignment)", data="one beat every 4s; the card names each as it fires", hold=24)

    visual_expect("cut: two camera posts exist", VISUAL_CUT_A and VISUAL_CUT_B)
    ->END


=== visual_camera_cut_driver
    # The generation, not the ids: ids are recycled across resets, so an id guard alone can
    # wake this loop up inside a later specimen.
    _gen = visual_generation()

    # --- beat 1: POINT ONLY --------------------------------------------------------
    await delay_sim(4)
    ->END if visual_generation() != _gen
    visual_camera(VISUAL_CUT_B, lens=(0, 400, 0), target_id=VISUAL_CUT_SUBJECT, assign=False)
    visual_expect("cut: beat 1 reached a console", visual_camera_delivered() > 0, f"{visual_camera_delivered()} consoles")
    visual_case_note("beat 1: POINTED at camB. Client NOT reassigned.")

    # --- beat 2: ASSIGN THEN POINT -------------------------------------------------
    # The order matters and it is this way round: the Game Master says so outright ("Assign
    # before setting comms up"), and the beat observed to work did it in this order. A yield
    # between them, because the engine wants a beat between assigning and pointing.
    await delay_sim(4)
    ->END if visual_generation() != _gen
    visual_client_assign(VISUAL_CUT_A)
    await delay_sim(0)
    visual_camera(VISUAL_CUT_A, lens=(0, 400, 0), target_id=VISUAL_CUT_SUBJECT)
    visual_case_note("beat 2: ASSIGNED to camA, then POINTED at it")

    # --- beat 3: MOVE THE OBJECT THE LENS IS ALREADY ON ----------------------------
    # Back onto the cambot, point at it, and only then move it - so the move is the single
    # thing under test.
    await delay_sim(4)
    ->END if visual_generation() != _gen
    visual_client_assign_back()
    await delay_sim(0)
    _cams = visual_cambots()
    for _cid in _cams:
        visual_camera(_cams[_cid], lens=(0, 300, 0 - 1500), target_id=VISUAL_CUT_SUBJECT)
    await delay_sim(1)
    visual_cambot_move(0 - 3000, 1200, 0 - 3000)
    visual_case_note("beat 3: MOVED the cambot the lens is already riding")

    # --- beat 4: delete the live dolly ----------------------------------------------
    await delay_sim(4)
    ->END if visual_generation() != _gen
    visual_client_assign(VISUAL_CUT_B)
    await delay_sim(0)
    visual_camera(VISUAL_CUT_B, lens=(0, 400, 0), target_id=VISUAL_CUT_SUBJECT)
    await delay_sim(2)
    ->END if visual_generation() != _gen
    delete_object(VISUAL_CUT_B)
    visual_case_note("beat 4: live camera post DELETED - hold, or fall away?")
    ->END
