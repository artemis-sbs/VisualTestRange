# Staging: how a specimen gets on screen, and the two entry points that walk the range.
#
# visual_run_index is what the stage's Prev / Re-run / Next buttons schedule. Everything
# else here is convenience around it.

=== visual_run_index
    # ONE SIM for the whole session. Only the scene's own objects go; the sim itself is never
    # blanked and each console's cambot is never destroyed, so a console is set up once at
    # startup and stays set up. sim_create() between specimens was what forced a camera
    # rebuild at every switch, and that rebuild needs a tick between assigning and pointing -
    # so the timing bug came back on every transition instead of being a one-off at startup.
    visual_reset_objects()
    await delay_sim(1)
    _lbl = visual_label_at()
    if _lbl is None:
        visual_case("No specimens", ["Nothing is tagged type: visual/*"], notes="check the story.mast imports")
        ->END
    await task_schedule(_lbl)
    ->END


@map/visual_range "Visual Range"
" Walk the specimens: the server tab shows the view, the card and Prev/Re-run/Next.
    visual_set_index(0)
    await task_schedule(visual_run_index)
    ->END


@map/visual_all "Visual Range - run every specimen"
" Build every specimen in turn, holding each one on screen. For a headless sweep of the
" machine-checkable half: --map visual_all --test 90
    visual_results_clear()
    _n = len(visual_specimens())
    log(f"visual: roster {visual_specimen_names()}", "visual")
    print(f"VISUAL ROSTER {_n}: {visual_specimen_names()}")
    for _slide in range(_n):
        visual_set_index(_slide)
        await task_schedule(visual_run_index)
        # Hold long enough to actually look at it when a browser is attached; harmless
        # headless, where the point is the VISUAL PASS/FAIL lines each specimen prints.
        # A specimen that plays out over time asks for longer; the rest get the default.
        await delay_sim(visual_hold(VISUAL_HOLD_SECONDS))
    visual_report()
    ->END


=== visual_rebuild_cambots
    # Only a safety net now. With one sim for the session a cambot should never go missing;
    # if one has, this re-establishes it with the tick between assigning and pointing that the
    # engine requires. Nothing calls it on the normal path.
    for _cc in visual_console_clients():
        _rc = visual_client_cambot(_cc)
        if _rc is not None:
            await delay_sim(1)
            visual_client_assign_one(_cc, _rc)
            await delay_sim(1)
            visual_camera_apply(_cc)
    ->END
