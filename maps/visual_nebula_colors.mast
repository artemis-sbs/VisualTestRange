@map/visual_nebula_emission "Visual: nebula emission over 1.0"
" One hue at four exposures - what an emission above 1.0 does to cloud and to icon.
    visual_set_index_by_name("nebula_emission")
    await task_schedule(run_visual_nebula_emission)
    ->END


=== run_visual_nebula_emission
metadata: ``` yaml
type: visual/nebula_emission
```
    _size = 1700

    # One color, four exposures of it. Everything else is held: same size, same density,
    # same ratio between the channels. Only the overall scale moves.
    for _espec in visual_neb_emission_specs():
        _ne = to_object(terrain_spawn(_espec[1], _espec[2], _espec[3], _espec[0], "#,visual_neb_emission", "nebula", "behav_nebula"))
        if _ne is not None:
            _ne.data_set.set("unselectable", 0, 0)
            terrain_setup_nebula(_ne, _size, 1.0, "red", seed=_espec[4])
            _ne.data_set.set("emission_red", _espec[5])
            _ne.data_set.set("emission_green", _espec[6])
            _ne.data_set.set("emission_blue", _espec[7])
            _ne.data_set.set("radar_color_override", _espec[8], 0)
            _ne.data_set.set("nebula_data_change", 1, 0)
            _ne.data_set.set("name_tag", _espec[0], 0)

    visual_widgets(visual_neb_emission_swatches())

    _anchor2 = visual_anchor(0, 0, 0)
    visual_camera(_anchor2, lens=(0, 4200, 0 - 13000))

    _expect2 = ~~[
        "four clouds of ONE color at four exposures, left dim to right bright",
        "the four swatches on the right should be IDENTICAL - the icon normalizes",
        "so an emission over 1.0 is a brightness lever, not a hue lever, for the icon",
        "but look at the CLOUDS: where a channel passes 1.0 the core has nowhere to go",
        "the bright ones wash toward white in the middle and only keep their hue at the edge",
    ]~~
    visual_case("Nebula emission over 1.0", _expect2,
        subtitle="does an emission above 1.0 change the color, or only the brightness",
        notes=visual_neb_emission_text(),
        data="one hue at x0.25, x1, x2, x4 - shader has no tonemap, so a channel over 1.0 clips at the target")

    visual_expect("neb emission: four exposures spawned",
        len(to_object_list(role("visual_neb_emission"))) == 4)
    # The claim on the card, as a check: normalization is scale-invariant, so every
    # exposure of one hue must derive the same icon.
    visual_expect("neb emission: every exposure derives the same icon",
        visual_neb_emission_icons_identical())
    ->END
